# ==============================================================
# CONFIGURATION VIDTELE BACKEND - VARIABLES POUR DOKPLOY / DOCKER
# ==============================================================

# Port d'écoute externe (par défaut: 8000)
PORT=8000

# Sécurité & Jetons JWT
# IMPORTANT: Générer une clé secrète robuste (ex: openssl rand -hex 32)
SECRET_KEY=change_me_super_secret_jwt_key_at_least_32_chars_vidtele_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
STREAM_TOKEN_EXPIRE_SECONDS=7200

# Base de données SQLite persistante (dans le volume /app/data)
DATABASE_URL=sqlite+aiosqlite:////app/data/vidtele.db

# Identifiants Telegram MTProto (obtenus sur https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=/app/data/vidtele_session

# RECOMMANDÉ POUR DOKPLOY : Session sous forme de texte (StringSession)
# Générez-la avec : python backend/export_session_string.py
# Si renseignée, aucun fichier .session n'est nécessaire sur le serveur !
TELEGRAM_STRING_SESSION=

# Identifiant numérique du canal privé Telegram (ex: -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# Stockage & Cache vidéo (volumes montés dans le conteneur)
CACHE_DIR=/app/cache
THUMBNAILS_DIR=/app/thumbnails
MAX_CACHE_GB=20.0

# Limites de lecture simultanée (anti-abus & respect VPS)
MAX_CONCURRENT_STREAMS_PER_USER=2
MAX_CONCURRENT_STREAMS_GLOBAL=30

# Synchronisation automatique du canal Telegram (en minutes)
SYNC_INTERVAL_MINUTES=15

# Compte administrateur initial (créé automatiquement au 1er démarrage)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminSecurePass2026!
