# ==============================================================
# CONFIGURATION VIDTELE BACKEND
# ==============================================================

# Sécurité & JWT
# IMPORTANT : générer une clé robuste (openssl rand -hex 32). Vide = clé aléatoire persistante générée dans le dossier de données
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
STREAM_TOKEN_EXPIRE_SECONDS=7200

# Base de données SQLite asynchrone
DATABASE_URL=sqlite+aiosqlite:///./vidtele.db

# Identifiants Telegram MTProto (obtenus sur https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=vidtele_session
# Facultatif pour Dokploy : string session générée via 'python export_session_string.py'
# Si fournie, aucun fichier de session physique (.session) n'est nécessaire sur le VPS !
TELEGRAM_STRING_SESSION=
# Identifiant numérique du canal privé (ex: -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# Stockage & Cache vidéo
CACHE_DIR=./cache
THUMBNAILS_DIR=./thumbnails
MAX_CACHE_GB=20.0

# Limites de lecture simultanée (anti-abus & respect VPS)
MAX_CONCURRENT_STREAMS_PER_USER=2
MAX_CONCURRENT_STREAMS_GLOBAL=30

# Synchronisation du canal Telegram (en minutes)
SYNC_INTERVAL_MINUTES=15

# Compte administrateur initial (créé seulement s'il n'existe aucun admin ; vide = mot de passe généré dans data/admin_initial_password.txt)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
# Secours : mettre true pour réécrire le mot de passe admin depuis ADMIN_DEFAULT_PASSWORD au prochain démarrage, puis remettre false
ADMIN_RESET_PASSWORD=false
